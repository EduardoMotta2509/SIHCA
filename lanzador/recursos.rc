#include <winver.h>
1 ICON "sihca.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "GDI - Grupo 09"
      VALUE "FileDescription", "SIHCA - Sistema de Horarios y Carga Academica"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "SIHCA"
      VALUE "OriginalFilename", "SIHCA.exe"
      VALUE "ProductName", "SIHCA"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
